{
  "name": "pantryshare-skia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Skia graphics components for the PantryShare Expo app.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "react-native": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./dist/index.js",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsup",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "build-pages": "storybook build -o components",
    "verify": "npm run check && npm run build && npm run build-storybook"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": "^2.12.0",
    "react": "^19.0.0",
    "react-native": ">=0.81.0 <1"
  },
  "devDependencies": {
    "@shopify/react-native-skia": "2.14.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/react": "19.3.0",
    "canvaskit-wasm": "0.41.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "0.21.2",
    "storybook": "10.6.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  }
}
